<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".Expenses">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <!-- Page heading: bold + italic -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/addExpense"
                android:textAppearance="@style/TextAppearance.PennyTracker.PageHeading"
                android:layout_marginBottom="20dp"/>

            <!-- Expense entry card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/amount"
                        android:textAppearance="@style/TextAppearance.PennyTracker.FieldLabel"
                        android:layout_marginBottom="6dp"/>
                    <EditText
                        android:id="@+id/edtAmount"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="numberDecimal"
                        android:hint="@string/number"
                        android:autofillHints=""

                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/date"
                        android:textAppearance="@style/TextAppearance.PennyTracker.FieldLabel"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"/>
                    <EditText
                        android:id="@+id/edtDate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="@string/dateFormat"
                        android:importantForAutofill="no"
                        android:inputType="date"

                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColorHint="@color/text_hint"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/addCategory"
                        android:textAppearance="@style/TextAppearance.PennyTracker.FieldLabel"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"/>
                    <EditText
                        android:id="@+id/edtCategory"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="text"
                        android:hint="@string/category"

                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColorHint="@color/text_hint"
                        tools:ignore="Autofill"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/description"
                        android:textAppearance="@style/TextAppearance.PennyTracker.FieldLabel"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"/>
                    <EditText
                        android:id="@+id/edtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="text"
                        android:hint="@string/addDescription"

                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColorHint="@color/text_hint"
                        tools:ignore="Autofill"/>

                    <Button
                        android:id="@+id/btnPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:backgroundTint="@color/primary_light"
                        android:textColor="@color/primary_dark"
                        android:textStyle="bold"
                        android:text="@string/uploadReceipt"
                        android:layout_marginTop="16dp"
                        style="@style/Widget.PennyTracker.Button"/>

                    <Button
                        android:id="@+id/btnSaveExpenses"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:backgroundTint="@color/primary"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:text="@string/save"
                        android:layout_marginTop="8dp"
                        style="@style/Widget.PennyTracker.Button"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Monthly Goals sub-section -->
            <TextView
                android:id="@+id/tvMonthlyGoals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/monthlyGoals"
                android:textAppearance="@style/TextAppearance.PennyTracker.SectionLabel"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <EditText
                        android:id="@+id/edtMinGoal"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="text"
                        android:hint="@string/minGoals"
                        android:importantForAutofill="no"

                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColorHint="@color/text_hint"/>

                    <EditText
                        android:id="@+id/edtMaxGoal"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="text"
                        android:hint="@string/maxGoals"

                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColorHint="@color/text_hint"
                        android:layout_marginTop="10dp"
                        tools:ignore="Autofill"/>

                    <Button
                        android:id="@+id/btnSaveGoals"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:backgroundTint="@color/primary"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:text="@string/save"
                        android:layout_marginTop="12dp"
                        style="@style/Widget.PennyTracker.Button"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="12dp"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav"/>

</androidx.constraintlayout.widget.ConstraintLayout>