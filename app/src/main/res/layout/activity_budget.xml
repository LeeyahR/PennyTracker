<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".Budget">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <!-- ── Monthly Budget Section ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monthly Budget"
                android:textAppearance="@style/TextAppearance.PennyTracker.PageHeading"
                android:layout_marginBottom="16dp"/>

            <!-- Budget card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                android:layout_marginBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/monthly_budget"
                        android:textAppearance="@style/TextAppearance.PennyTracker.FieldLabel"
                        android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etBudget"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:autofillHints=""
                        android:hint="@string/enter_budget"
                        android:inputType="numberDecimal"

                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        tools:ignore="VisualLintTextFieldSize"/>

                    <Button
                        android:id="@+id/btnSaveBudget"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Save Budget"
                        android:backgroundTint="@color/primary"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        style="@style/Widget.PennyTracker.Button"
                        tools:ignore="HardcodedText,VisualLintButtonSize"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Category Limits Section ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category Limits"
                android:textAppearance="@style/TextAppearance.PennyTracker.SectionLabel"
                android:layout_marginBottom="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/category_limits"
                        android:textAppearance="@style/TextAppearance.PennyTracker.FieldLabel"
                        android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etCategoryName"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="@string/category_name_e_g_food"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords"

                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        tools:ignore="VisualLintTextFieldSize"/>

                    <EditText
                        android:id="@+id/etLimit"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="@string/limit"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"

                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColorHint="@color/text_hint"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="10dp"
                        tools:ignore="VisualLintTextFieldSize"/>

                    <Button
                        android:id="@+id/btnAddCategory"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="@string/add"
                        android:backgroundTint="@color/primary"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        style="@style/Widget.PennyTracker.Button"
                        tools:ignore="VisualLintButtonSize"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/categoryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="12dp"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav"
        tools:ignore="VisualLintBottomNav"/>
</androidx.constraintlayout.widget.ConstraintLayout>